# Navegador: msedge (já vem no Windows Server) ou chrome
NAVEGADOR=msedge

# false = mostra o navegador abrindo (use assim no primeiro teste)
HEADLESS=false

# Modo do certificado:
#   windows -> certificado instalado no repositório do usuário do Windows
#              + política AutoSelectCertificateForUrls (ver politica-edge.reg)
#   pfx     -> arquivo .pfx (só para teste local; em produção prefira "windows")
CERT_MODO=windows

# Usados apenas quando CERT_MODO=pfx
CERT_PFX_PATH=C:\Robos\fgts\cert\empresa.pfx
CERT_PFX_SENHA=

# Pasta onde ficam prints e traces de cada execução
PASTA_SAIDA=./saida

# Tempo máximo (ms) de espera por cada tela
TIMEOUT=30000

# Tempo máximo (ms) para escolher o certificado na janela do Edge depois de clicar em Empregador
TIMEOUT_CERTIFICADO=120000



# API HTTP chamada pelo portal (só rede interna)
#   HOST=127.0.0.1 -> só esta máquina; 0.0.0.0 -> aceita da rede (libere a porta só para o servidor do portal)
HOST=127.0.0.1
PORTA=3100

# Token que o portal envia em "Authorization: Bearer <token>"
ROBO_TOKEN=troque-por-um-token-longo-e-aleatorio
